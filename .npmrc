# Réglages npm du projet (npm 11.19 ou plus récent ; voir README, Installation).
# Un paquet qui a un script d'installation (preinstall, install, postinstall) sans entrée dans allowScripts
# (package.json) fait échouer l'installation, au lieu de tourner avec un simple avertissement.
strict-allow-scripts=true
# npm ou Node trop ancien (engines du package.json) : l'installation échoue avant tout script. npm 10 ne connaît pas
# allowScripts ni strict-allow-scripts : sans ce refus, il lancerait tous les scripts d'installation.
engine-strict=true
# Pas de vérification de version de npm sur Internet à chaque commande (npm run dev…).
update-notifier=false
